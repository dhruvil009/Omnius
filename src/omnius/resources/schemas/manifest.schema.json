{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_date",
    "journal_dir",
    "summary",
    "tasks",
    "skipped",
    "notes"
  ],
  "properties": {
    "run_date": {
      "type": "string"
    },
    "journal_dir": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "repo_slug",
          "source_ref",
          "filename",
          "max_time_minutes",
          "complexity"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "repo_slug": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "max_time_minutes": {
            "type": "integer"
          },
          "complexity": {
            "type": "string"
          }
        }
      }
    },
    "skipped": {
      "type": "array"
    },
    "notes": {
      "type": "string"
    }
  }
}
