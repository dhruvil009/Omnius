{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_date",
    "journal_dir",
    "summary",
    "tasks",
    "skipped",
    "notes"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "planner",
        "fallback_synthesized"
      ]
    },
    "run_date": {
      "type": "string"
    },
    "journal_dir": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "repo_slug",
          "source_ref",
          "filename",
          "max_time_minutes",
          "complexity"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "implementation",
              "design",
              "research",
              "comment_resolution"
            ]
          },
          "repo_slug": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "local_queue",
              "recurring_queue",
              "github_issue",
              "pr_review",
              "manual",
              "fallback"
            ]
          },
          "source_ref": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "max_time_minutes": {
            "type": "integer"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "complexity": {
            "type": "string"
          },
          "project_context": {
            "type": "string"
          },
          "file_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quality_phases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completion_contract": {
            "type": "object",
            "properties": {
              "artifact": {
                "type": "string"
              },
              "archive_on": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "skip_reason": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
